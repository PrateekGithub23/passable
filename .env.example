# Copy to .env (git-ignored) and fill in. Local development needs none of these:
# the defaults point at the Docker Compose services.

# Postgres + PostGIS. Local default: postgres://passable:passable@localhost:5433/passable
# Hosted (Neon): use the DIRECT connection string (pooling off), with sslmode=require.
DATABASE_URL=

# Redis. Local default: redis://localhost:6379/0 (Docker Compose).
# Hosted free tier: rediss://default:<password>@<host>:<port>   (rediss = TLS)
# Empty string = run without Redis (single instance, no cache, no rate limits).
REDIS_URL=
